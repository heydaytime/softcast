# Softcast backend environment (production / Raspberry Pi).
#
# Real file lives at /etc/softcast/backend.env on the Pi (root:root, chmod 0600),
# referenced by softcast-backend.service. This is only a template — no secrets here.

# Bind to localhost only; Caddy (on the same host) is the public entrypoint.
HOST=127.0.0.1
PORT=4000

# Public web origin, used to build session/screen links returned by the API.
PUBLIC_WEB_URL=https://softcast.studio

# Only the production frontend may call the API (also used as Clerk authorizedParties).
CORS_ALLOWED_ORIGINS=https://softcast.studio

# Local Redis with AOF persistence (see deploy/redis.conf).
REDIS_URL=redis://localhost:6379

# Clerk (DEV instance for now — swap to pk_live/sk_live when going to a prod instance).
# CLERK_SECRET_KEY is server-only and must never reach the client or git.
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
