# Softcast edge block for hdtrs (the public Cloudflare origin / GCP WireGuard client).
#
# hdtrs runs a single shared /etc/caddy/Caddyfile that also serves unrelated sites
# (api.blendr.live, ai.heydaytime.net). APPEND this block to that file — do not
# replace it — then `sudo caddy validate` and `sudo systemctl reload caddy`.
#
# Caddy auto-provisions a Let's Encrypt cert for api.softcast.studio (Cloudflare
# forwards the HTTP-01 challenge), so Cloudflare's Full TLS mode reaches the origin.
# Caddy v2 preserves the incoming Host header, so the Pi's `http://api.softcast.studio`
# site block matches. reverse_proxy forwards WebSocket upgrades automatically, so
# wss://api.softcast.studio/ws works through both Caddy hops.
#
# 192.168.100.150 is the Pi over WireGuard; :80 is the Pi's own Caddy -> backend :4000.

api.softcast.studio {
	reverse_proxy 192.168.100.150:80
}
