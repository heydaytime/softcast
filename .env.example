NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Backend needs the publishable key too (same public pk_ value) for authenticateRequest().
# In dev it falls back to NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY; set this explicitly in production.
CLERK_PUBLISHABLE_KEY=
# Production frontend values:
# NEXT_PUBLIC_BACKEND_URL=https://api.softcast.studio
# NEXT_PUBLIC_WS_URL=wss://api.softcast.studio/ws
PUBLIC_WEB_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://softcast.studio
REDIS_URL=redis://localhost:6379
PORT=4000
